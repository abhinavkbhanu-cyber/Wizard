<Window x:Class="RB22.GameBooster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RB22 Performance Overlay"
        Width="430"
        Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="20"
            Background="#F20A0F1D"
            BorderBrush="#664A90FF"
            BorderThickness="1"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".60"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RB22"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <Border Margin="9,1,0,0"
                                Padding="7,3"
                                CornerRadius="7"
                                Background="#263B78FF"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#DCE8FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="PERFORMANCE MONITOR"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Opacity=".55"
                               Foreground="White"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Content="×"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="19"
                        FontWeight="Light"
                        Foreground="#DCE5FF"
                        Background="#241A2740"
                        BorderBrush="#334A5F85"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- Stats -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Margin="0,0,6,6"
                        Padding="13,10"
                        CornerRadius="13"
                        Background="#40141E32"
                        BorderBrush="#223B5575"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CPU"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8FA4C5"/>
                            <TextBlock x:Name="Cpu"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="%"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Opacity=".45"
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Margin="6,0,0,6"
                        Padding="13,10"
                        CornerRadius="13"
                        Background="#40141E32"
                        BorderBrush="#223B5575"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="RAM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8FA4C5"/>
                            <TextBlock x:Name="Ram"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="%"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Opacity=".45"
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Margin="0,6,6,0"
                        Padding="13,10"
                        CornerRadius="13"
                        Background="#40141E32"
                        BorderBrush="#223B5575"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PING"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8FA4C5"/>
                            <TextBlock x:Name="Ping"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="ms"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Opacity=".45"
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Margin="6,6,0,0"
                        Padding="13,10"
                        CornerRadius="13"
                        Background="#40141E32"
                        BorderBrush="#223B5575"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="FPS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#8FA4C5"/>
                            <TextBlock x:Name="Fps"
                                       Text="N/A"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="frames"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="9"
                                   Opacity=".45"
                                   Foreground="White"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="2,12,2,0">
                <TextBlock Text="●  MONITORING"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#8FA4C5"
                           VerticalAlignment="Center"/>
                <TextBlock Text="F8  •  TOGGLE"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Opacity=".45"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>