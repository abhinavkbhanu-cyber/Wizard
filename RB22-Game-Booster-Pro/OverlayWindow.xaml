<Window x:Class="RB22.GameBooster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RB22 Performance Overlay"
        Width="560"
        Height="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="20"
            Background="#F20A0F1D"
            BorderBrush="#664A90FF"
            BorderThickness="1"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".60"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RB22"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <Border Margin="9,1,0,0"
                                Padding="7,3"
                                CornerRadius="7"
                                Background="#263B78FF"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#DCE8FF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="PERFORMANCE ENGINE V2"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Opacity=".55"
                               Foreground="White"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Content="×"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="19"
                        FontWeight="Light"
                        Foreground="#DCE5FF"
                        Background="#241A2740"
                        BorderBrush="#334A5F85"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <!-- Stats -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                <Border Margin="0,0,6,0" Padding="12,10" CornerRadius="13" Background="#40141E32" BorderBrush="#223B5575" BorderThickness="1">
                    <StackPanel><TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#8FA4C5"/><TextBlock x:Name="Cpu" Text="—" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="usage %" FontSize="9" Opacity=".45" Foreground="White"/></StackPanel>
                </Border>
                <Border Margin="6,0,6,0" Padding="12,10" CornerRadius="13" Background="#40141E32" BorderBrush="#223B5575" BorderThickness="1">
                    <StackPanel><TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#8FA4C5"/><TextBlock x:Name="Ram" Text="—" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="usage %" FontSize="9" Opacity=".45" Foreground="White"/></StackPanel>
                </Border>
                <Border Margin="6,0,6,0" Padding="12,10" CornerRadius="13" Background="#40141E32" BorderBrush="#223B5575" BorderThickness="1">
                    <StackPanel><TextBlock Text="FPS" FontSize="10" FontWeight="Bold" Foreground="#8FA4C5"/><TextBlock x:Name="Fps" Text="N/A" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="presented" FontSize="9" Opacity=".45" Foreground="White"/></StackPanel>
                </Border>
                <Border Margin="6,0,0,0" Padding="12,10" CornerRadius="13" Background="#40141E32" BorderBrush="#223B5575" BorderThickness="1">
                    <StackPanel><TextBlock Text="1% LOW" FontSize="10" FontWeight="Bold" Foreground="#8FA4C5"/><TextBlock x:Name="Low1" Text="N/A" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="FPS equivalent" FontSize="9" Opacity=".45" Foreground="White"/></StackPanel>
                </Border>
            </UniformGrid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="2,10,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center"><TextBlock Text="●  LIVE TELEMETRY"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#8FA4C5"
                           VerticalAlignment="Center"/><TextBlock x:Name="State" Text="Searching for game telemetry…" FontSize="9" Foreground="#667798" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="GPU frame work: " FontSize="10" Foreground="#8FA4C5"/><TextBlock x:Name="Gpu" Text="N/A" FontSize="10" Foreground="White"/><TextBlock Text="   Frame: " FontSize="10" Foreground="#8FA4C5" Margin="12,0,0,0"/><TextBlock x:Name="Frame" Text="N/A" FontSize="10" Foreground="White"/></StackPanel><TextBlock Grid.Column="2" Text="F8  •  TOGGLE"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Opacity=".45"
                           Foreground="White"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>