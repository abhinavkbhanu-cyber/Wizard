<Window x:Class="RB22.GameBooster.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RB22 Game Booster Pro" Width="1100" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#030611" Foreground="#EAF1FF">
<Grid ClipToBounds="True">
 <Grid.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#02040D" Offset="0"/>
   <GradientStop Color="#07142A" Offset="0.48"/>
   <GradientStop Color="#030811" Offset="1"/>
  </LinearGradientBrush>
 </Grid.Background>

 <!-- RB22 night-sky wallpaper -->
 <Canvas IsHitTestVisible="False" Opacity="0.95">
  <!-- distant blue atmospheric glow -->
  <Ellipse Width="900" Height="500" Canvas.Left="-260" Canvas.Top="250" Fill="#102D52" Opacity="0.18">
   <Ellipse.Effect><BlurEffect Radius="55"/></Ellipse.Effect>
  </Ellipse>
  <Ellipse Width="700" Height="360" Canvas.Left="560" Canvas.Top="300" Fill="#173B65" Opacity="0.16">
   <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
  </Ellipse>

  <!-- aurora bands -->
  <Path Stroke="#58F6D0" StrokeThickness="34" Opacity="0.13" Data="M -80,420 C 160,240 330,530 520,330 S 850,180 1180,350">
   <Path.Effect><BlurEffect Radius="30"/></Path.Effect>
  </Path>
  <Path Stroke="#6B8CFF" StrokeThickness="28" Opacity="0.14" Data="M -100,500 C 180,330 300,560 560,390 S 900,260 1200,410">
   <Path.Effect><BlurEffect Radius="28"/></Path.Effect>
  </Path>
  <Path Stroke="#9D6BFF" StrokeThickness="24" Opacity="0.10" Data="M -100,570 C 180,400 350,600 590,440 S 920,350 1200,470">
   <Path.Effect><BlurEffect Radius="32"/></Path.Effect>
  </Path>

  <!-- moon glow + moon -->
  <Ellipse Width="190" Height="190" Canvas.Left="815" Canvas.Top="35" Fill="#DDEBFF" Opacity="0.10">
   <Ellipse.Effect><BlurEffect Radius="35"/></Ellipse.Effect>
  </Ellipse>
  <Ellipse Width="112" Height="112" Canvas.Left="854" Canvas.Top="48" Fill="#F3F7FF" Opacity="0.96"/>
  <Ellipse Width="112" Height="112" Canvas.Left="876" Canvas.Top="38" Fill="#071225" Opacity="0.98"/>

  <!-- stars -->
  <Ellipse Width="3" Height="3" Canvas.Left="75" Canvas.Top="78" Fill="White"/>
  <Ellipse Width="2" Height="2" Canvas.Left="150" Canvas.Top="145" Fill="#D8E8FF"/>
  <Ellipse Width="4" Height="4" Canvas.Left="240" Canvas.Top="62" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="315" Canvas.Top="175" Fill="#BFD7FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="405" Canvas.Top="92" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="505" Canvas.Top="48" Fill="#CFE1FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="605" Canvas.Top="135" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="700" Canvas.Top="70" Fill="#D9E8FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="760" Canvas.Top="185" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="950" Canvas.Top="175" Fill="#C9DCFF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="1020" Canvas.Top="90" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="1070" Canvas.Top="220" Fill="#DCEAFF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="40" Canvas.Top="250" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="125" Canvas.Top="330" Fill="#BFD7FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="210" Canvas.Top="285" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="350" Canvas.Top="350" Fill="#DCEAFF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="475" Canvas.Top="255" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="575" Canvas.Top="320" Fill="#BFD7FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="675" Canvas.Top="270" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="790" Canvas.Top="330" Fill="#DCEAFF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="1010" Canvas.Top="300" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="1090" Canvas.Top="390" Fill="#BFD7FF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="280" Canvas.Top="430" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="420" Canvas.Top="470" Fill="#DCEAFF"/>
  <Ellipse Width="3" Height="3" Canvas.Left="720" Canvas.Top="450" Fill="#FFFFFF"/>
  <Ellipse Width="2" Height="2" Canvas.Left="880" Canvas.Top="420" Fill="#DCEAFF"/>
 </Canvas>

 <!-- dark glass overlay keeps text readable -->
 <Rectangle Fill="#030714" Opacity="0.18"/>

 <StackPanel Margin="42">
  <DockPanel>
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="RB22" FontSize="34" FontWeight="Bold"/><TextBlock Text="GAME BOOSTER PRO" FontSize="12" Opacity=".7"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="DeviceLabel" Text="DETECTING DEVICE..." HorizontalAlignment="Right"/><TextBlock Text="Windows 10/11 • Universal Mode" FontSize="11" Opacity=".6"/></StackPanel>
  </DockPanel>

  <Border Margin="0,30,0,20" Padding="28" CornerRadius="22" Background="#9910182E" BorderBrush="#334A6FA8" BorderThickness="1">
   <Grid>
    <StackPanel><TextBlock Text="READY FOR BATTLE" FontSize="13" Opacity=".7"/><TextBlock Text="Boost your game session" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,20"/><StackPanel Orientation="Horizontal"><Button x:Name="BasicButton" Content="BASIC BOOST" Width="125" Height="50" FontWeight="Bold" Click="BasicBoost_Click" Margin="0,0,8,0"/><Button x:Name="AdvancedButton" Content="ADVANCED BOOST" Width="145" Height="50" FontWeight="Bold" Click="AdvancedBoost_Click" Margin="0,0,8,0"/><Button x:Name="TurboButton" Content="TURBO BOOST" Width="125" Height="50" FontWeight="Bold" Click="TurboBoost_Click"/></StackPanel></StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="390"><TextBlock Text="F8  OVERLAY" FontSize="13" FontWeight="Bold"/><TextBlock Text="Press F8 to show/hide the live gaming overlay. Change the hotkey in Settings." TextWrapping="Wrap" Opacity=".7" Margin="0,7,0,0"/></StackPanel>
   </Grid>
  </Border>

  <UniformGrid Columns="4" Margin="0,0,0,18">
   <Border Margin="0,0,10,0" Padding="18" CornerRadius="16" Background="#9910182E"><StackPanel><TextBlock Text="CPU" Opacity=".65"/><TextBlock x:Name="CpuText" Text="—" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="CpuTemp" Text="Temp —"/></StackPanel></Border>
   <Border Margin="0,0,10,0" Padding="18" CornerRadius="16" Background="#9910182E"><StackPanel><TextBlock Text="GPU" Opacity=".65"/><TextBlock x:Name="GpuText" Text="—" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
   <Border Margin="0,0,10,0" Padding="18" CornerRadius="16" Background="#9910182E"><StackPanel><TextBlock Text="RAM" Opacity=".65"/><TextBlock x:Name="RamText" Text="—" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
   <Border Padding="18" CornerRadius="16" Background="#9910182E"><StackPanel><TextBlock Text="NETWORK" Opacity=".65"/><TextBlock x:Name="PingText" Text="—" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="NetText" Text="DNS ready"/><TextBlock x:Name="MemoryModeText" Text="Auto memory clean: ON at 70%" FontSize="10" Opacity=".55" Margin="0,3,0,0"/></StackPanel></Border>
  </UniformGrid>

  <DockPanel>
   <Border Padding="20" CornerRadius="16" Background="#9910182E" Width="500" DockPanel.Dock="Left"><StackPanel><TextBlock Text="NETWORK OPTIMIZER" FontSize="15" FontWeight="Bold"/><TextBlock Text="Choose a DNS service or let RB22 test all four." Opacity=".65" Margin="0,5,0,12"/><ComboBox x:Name="DnsBox" SelectedIndex="0" Height="38"><ComboBoxItem Content="Auto Select"/><ComboBoxItem Content="Cloudflare • 1.1.1.1"/><ComboBoxItem Content="Google • 8.8.8.8"/><ComboBoxItem Content="Quad9 • 9.9.9.9"/><ComboBoxItem Content="OpenDNS • 208.67.222.222"/></ComboBox><Button Content="TEST SERVERS" Margin="0,10,0,0" Height="36" Click="TestDns_Click"/></StackPanel></Border>
   <Border Margin="18,0,0,0" Padding="20" CornerRadius="16" Background="#9910182E"><StackPanel><TextBlock Text="TOOLS" FontSize="15" FontWeight="Bold"/><TextBlock Text="3 boost modes • auto memory clean at 70% • laptop-aware performance • safe background cleanup • live hardware stats" TextWrapping="Wrap" Opacity=".65" Margin="0,5,0,15"/><Button Content="SETTINGS / HOTKEY" Height="38" Click="Settings_Click"/><TextBlock x:Name="StatusText" Text="Status: Ready" Margin="0,12,0,0" Opacity=".75"/></StackPanel></Border>
  </DockPanel>
 </StackPanel>
</Grid>
</Window>