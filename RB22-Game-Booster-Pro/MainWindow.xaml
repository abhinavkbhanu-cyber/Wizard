<Window x:Class="RB22.GameBooster.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RB22 Game Booster Pro" Width="1536" Height="864" MinWidth="1200" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
 Background="#04050B" Foreground="#F3F7FF" FontFamily="Segoe UI">

<Window.Resources>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="#EAF2FF"/>
  <Setter Property="Background" Value="#10162A"/>
  <Setter Property="BorderBrush" Value="#263454"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Padding" Value="12,0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"/>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="#DCE6FF"/>
  <Setter Property="Cursor" Value="Hand"/>
 </Style>
</Window.Resources>

<Grid ClipToBounds="True">
 <Border CornerRadius="20" Background="#04050B" BorderBrush="#202B4A" BorderThickness="1">
  <Grid>
   <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#03040A" Offset="0"/>
     <GradientStop Color="#080B18" Offset=".45"/>
     <GradientStop Color="#05030B" Offset="1"/>
    </LinearGradientBrush>
   </Grid.Background>

   <!-- Subtle gamer glow -->
   <Canvas IsHitTestVisible="False" Opacity=".9">
    <Ellipse Width="850" Height="480" Canvas.Left="-280" Canvas.Top="80" Fill="#1739A0" Opacity=".13">
    </Ellipse>
    <Ellipse Width="700" Height="430" Canvas.Left="900" Canvas.Top="280" Fill="#8A155D" Opacity=".12">
    </Ellipse>
    <Ellipse Width="260" Height="260" Canvas.Left="1110" Canvas.Top="-100" Fill="#6D4AFF" Opacity=".10">
    </Ellipse>
    <Path Stroke="#25E8FF" StrokeThickness="26" Opacity=".06"
          Data="M -100,620 C 250,340 430,720 760,470 S 1240,270 1650,500">
     <Path.Effect><BlurEffect Radius="35"/></Path.Effect>
    </Path>
    <Path Stroke="#B44CFF" StrokeThickness="22" Opacity=".055"
          Data="M -100,760 C 280,500 470,780 820,560 S 1260,430 1650,620">
     <Path.Effect><BlurEffect Radius="35"/></Path.Effect>
    </Path>
    <Ellipse Width="3" Height="3" Canvas.Left="150" Canvas.Top="95" Fill="White"/>
    <Ellipse Width="2" Height="2" Canvas.Left="330" Canvas.Top="165" Fill="#D6E8FF"/>
    <Ellipse Width="3" Height="3" Canvas.Left="570" Canvas.Top="90" Fill="White"/>
    <Ellipse Width="2" Height="2" Canvas.Left="790" Canvas.Top="155" Fill="#B9D9FF"/>
    <Ellipse Width="3" Height="3" Canvas.Left="1050" Canvas.Top="120" Fill="White"/>
    <Ellipse Width="2" Height="2" Canvas.Left="1320" Canvas.Top="90" Fill="#D6E8FF"/>
    <Ellipse Width="3" Height="3" Canvas.Left="1450" Canvas.Top="210" Fill="White"/>
   </Canvas>

   <!-- Sidebar -->
   <Border Width="92" HorizontalAlignment="Left" Background="#070A13" BorderBrush="#171E35" BorderThickness="0,0,1,0">
    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0">
     <Border Width="54" Height="54" CornerRadius="17" Background="#11152A" BorderBrush="#704CFF" BorderThickness="1.5">
      <Grid>
       <TextBlock Text="RB" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#5CF2FF"/><GradientStop Color="#A85CFF" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
       </TextBlock>
      </Grid>
     </Border>
     <TextBlock Text="22" FontSize="10" FontWeight="Bold" Foreground="#7E8DFF" HorizontalAlignment="Center" Margin="0,4,0,26"/>

     <Button ToolTip="Home" Content="⌂" Width="54" Height="54" Background="#17143A" BorderBrush="#5D55FF" Margin="0,0,0,10"/>
     <Button ToolTip="Boost" Content="⚡" Width="54" Height="54" Click="AdvancedBoost_Click" Background="#0E1426" BorderBrush="#202C49" Margin="0,0,0,10"/>
     <Button ToolTip="Games" Content="▣" Width="54" Height="54" Click="GameLibrary_Click" Background="#0E1426" BorderBrush="#202C49" Margin="0,0,0,10"/>
     <Button ToolTip="Performance" Content="◈" Width="54" Height="54" Click="Performance_Click" Background="#0E1426" BorderBrush="#202C49" Margin="0,0,0,10"/>
     <Button ToolTip="Memory" Content="▤" Width="54" Height="54" Click="Memory_Click" Background="#0E1426" BorderBrush="#202C49" Margin="0,0,0,10"/>
     <Button ToolTip="Network" Content="⌁" Width="54" Height="54" Click="Network_Click" Background="#0E1426" BorderBrush="#202C49" Margin="0,0,0,10"/>
     <Button ToolTip="Settings" Content="⚙" Width="54" Height="54" Click="Settings_Click" Background="#0E1426" BorderBrush="#202C49"/>
    </StackPanel>
   </Border>

   <!-- Window controls -->
   <StackPanel Panel.ZIndex="100" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
    <Button Content="—" Width="40" Height="34" Background="Transparent" BorderBrush="Transparent" Click="Minimize_Click"/>
    <Button Content="×" Width="40" Height="34" Background="Transparent" BorderBrush="Transparent" FontSize="22" Click="Close_Click"/>
   </StackPanel>

   <ScrollViewer Panel.ZIndex="1" Margin="92,0,0,0" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" CacheMode="BitmapCache">
    <StackPanel Margin="34,38,34,26">

     <!-- Header -->
     <Grid Margin="0,0,0,22">
      <StackPanel>
       <TextBlock x:Name="UsernameText" Text="RB22" FontSize="13" FontWeight="Bold" Foreground="#6CEBFF"/>
       <TextBlock Text="GAMING CONTROL" FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
       <TextBlock Text="READY" FontSize="11" Foreground="#7583A8" Margin="2,2,0,0"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="18" Padding="14,8"
              Background="#0B1719" BorderBrush="#1CCDBD" BorderThickness="1">
       <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Fill="#37F0C9" Margin="0,0,8,0"/>
        <TextBlock Text="SYSTEM ONLINE" FontSize="11" FontWeight="SemiBold" Foreground="#8FFFE5"/>
       </StackPanel>
      </Border>
     </Grid>

     <!-- Main HUD -->
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="0,0,16,0" Height="330" CornerRadius="24"
              Background="#090D19" BorderBrush="#202D4B" BorderThickness="1">
       <Grid>
        <Ellipse Width="285" Height="285" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#423BFF" StrokeThickness="2" Opacity=".75"/>
        <Ellipse Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#24DFFF" StrokeThickness="1" Opacity=".45"/>
        <Ellipse Width="205" Height="205" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#0C1020" Stroke="#7A4DFF" StrokeThickness="3">
        </Ellipse>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock Text="⚡" FontSize="34" HorizontalAlignment="Center" Foreground="#6DEEFF"/>
         <TextBlock x:Name="ReadyText" Text="READY" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
         <TextBlock Text="BOOST" FontSize="11" FontWeight="Bold" Foreground="#7D8AFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Content="BOOST NOW" Width="150" Height="42" VerticalAlignment="Bottom" Margin="0,0,0,26"
                Background="#18184A" BorderBrush="#685CFF" FontWeight="Bold" Click="AdvancedBoost_Click"/>
       </Grid>
      </Border>

      <!-- Telemetry -->
      <UniformGrid Grid.Column="1" Columns="2" Rows="2">
       <Border Margin="0,0,8,8" CornerRadius="17" Background="#090E19" BorderBrush="#1C2A45">
        <StackPanel Margin="18"><TextBlock Text="CPU" FontSize="11" Foreground="#7282A8"/><TextBlock x:Name="CpuText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="CpuSubText" Text="Loading" FontSize="10" Foreground="#53617F"/></StackPanel>
       </Border>
       <Border Margin="8,0,0,8" CornerRadius="17" Background="#090E19" BorderBrush="#1C2A45">
        <StackPanel Margin="18"><TextBlock Text="RAM" FontSize="11" Foreground="#7282A8"/><TextBlock x:Name="RamText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="RamSubText" Text="Loading" FontSize="10" Foreground="#53617F"/></StackPanel>
       </Border>
       <Border Margin="0,8,8,0" CornerRadius="17" Background="#090E19" BorderBrush="#1C2A45">
        <StackPanel Margin="18"><TextBlock Text="GPU" FontSize="11" Foreground="#7282A8"/><TextBlock x:Name="GpuText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="GpuSubText" Text="Detected" FontSize="10" Foreground="#53617F"/></StackPanel>
       </Border>
       <Border Margin="8,8,0,0" CornerRadius="17" Background="#090E19" BorderBrush="#1C2A45">
        <StackPanel Margin="18"><TextBlock Text="DISK" FontSize="11" Foreground="#7282A8"/><TextBlock x:Name="DiskText" Text="—" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="DiskSubText" Text="Loading" FontSize="10" Foreground="#53617F"/></StackPanel>
       </Border>
      </UniformGrid>
     </Grid>

     <!-- Modes -->
     <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Height="88" Margin="0,0,8,0" Click="BasicBoost_Click" Background="#0A1718" BorderBrush="#18CDBB">
       <StackPanel><TextBlock Text="BASIC" FontSize="17" FontWeight="Bold" Foreground="#4CE8D1" HorizontalAlignment="Center"/><TextBlock Text="SAFE" FontSize="10" Foreground="#5E827D" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Button>
      <Button Grid.Column="1" Height="88" Margin="8,0,8,0" Click="AdvancedBoost_Click" Background="#0C1223" BorderBrush="#397FFF">
       <StackPanel><TextBlock Text="ADVANCED" FontSize="17" FontWeight="Bold" Foreground="#6AA9FF" HorizontalAlignment="Center"/><TextBlock Text="BALANCED" FontSize="10" Foreground="#5D7298" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Button>
      <Button Grid.Column="2" Height="88" Margin="8,0,0,0" Click="TurboBoost_Click" Background="#190B18" BorderBrush="#F03D91">
       <StackPanel><TextBlock Text="TURBO" FontSize="17" FontWeight="Bold" Foreground="#FF65B0" HorizontalAlignment="Center"/><TextBlock Text="MAX" FontSize="10" Foreground="#8C5574" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
      </Button>
     </Grid>

     <!-- Feature grid -->
     <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Height="74" Margin="0,0,6,0" Click="AIBoost_Click" Background="#0A0E1B" BorderBrush="#263456"><StackPanel><TextBlock Text="AI" FontSize="19" FontWeight="Bold" Foreground="#B77CFF" HorizontalAlignment="Center"/><TextBlock Text="SMART" FontSize="9" Foreground="#667294" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="1" Height="74" Margin="6,0" Click="QuickScan_Click" Background="#0A0E1B" BorderBrush="#263456"><StackPanel><TextBlock Text="SCAN" FontSize="17" FontWeight="Bold" Foreground="#5DEBFF" HorizontalAlignment="Center"/><TextBlock Text="QUICK" FontSize="9" Foreground="#667294" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="2" Height="74" Margin="6,0" Click="SystemCleaner_Click" Background="#0A0E1B" BorderBrush="#263456"><StackPanel><TextBlock Text="CLEAN" FontSize="17" FontWeight="Bold" Foreground="#5FE3B7" HorizontalAlignment="Center"/><TextBlock Text="SYSTEM" FontSize="9" Foreground="#667294" HorizontalAlignment="Center"/></StackPanel></Button>
      <Button Grid.Column="3" Height="74" Margin="6,0,0,0" Click="AdvancedSettings_Click" Background="#0A0E1B" BorderBrush="#263456"><StackPanel><TextBlock Text="TOOLS" FontSize="17" FontWeight="Bold" Foreground="#FF73A9" HorizontalAlignment="Center"/><TextBlock Text="CONTROL" FontSize="9" Foreground="#667294" HorizontalAlignment="Center"/></StackPanel></Button>
     </Grid>

     <!-- Compact automation -->
     <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Margin="0,0,8,0" Padding="18" CornerRadius="17" Background="#080C17" BorderBrush="#1C2945">
       <StackPanel>
        <TextBlock Text="AUTOMATION" FontSize="13" FontWeight="Bold" Foreground="#9DA9C7"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Auto RAM cleanup" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="AutoMemoryCheck" IsChecked="True" Checked="AutoMemory_Checked" Unchecked="AutoMemory_Unchecked" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Game priority" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="GamePriorityCheck" IsChecked="True" Checked="GamePriority_Checked" Unchecked="GamePriority_Unchecked" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Adaptive mode" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="AdaptiveGameCheck" IsChecked="True" Checked="AdaptiveGame_Checked" Unchecked="AdaptiveGame_Unchecked" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="17" Background="#080C17" BorderBrush="#1C2945">
       <StackPanel>
        <TextBlock Text="NETWORK / OVERLAY" FontSize="13" FontWeight="Bold" Foreground="#9DA9C7"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="DNS optimizer" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="DnsCheck" IsChecked="True" Checked="Dns_Checked" Unchecked="Dns_Unchecked" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="Live monitor" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="MonitorCheck" IsChecked="True" Checked="Monitor_Checked" Unchecked="Monitor_Unchecked" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBlock Text="F8 overlay" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="OverlayCheck" IsChecked="True" Checked="Overlay_Checked" Unchecked="Overlay_Unchecked" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
      </Border>
     </Grid>

     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Status: Ready" Foreground="#677698" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="RB22 • GAMER MODE" Foreground="#4E5B7A" FontSize="10" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</Grid>
</Window>