<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/rb22_bg">
<LinearLayout android:orientation="vertical" android:padding="22dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:src="@drawable/rb22_logo" android:contentDescription="RB22 logo"
            android:layout_width="72dp" android:layout_height="72dp"/>
        <LinearLayout android:orientation="vertical" android:layout_marginStart="14dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="RB22" android:textColor="#FFFFFF" android:textSize="34sp"
                android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="GAME BOOSTER PRO" android:textColor="#9AA8D8" android:textSize="13sp"
                android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:text="WELCOME BACK" android:textColor="#D0D8FF" android:textSize="13sp"
        android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Your games. Our priority." android:textColor="#9AA8D8" android:textSize="18sp"
        android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_marginTop="20dp" android:background="@drawable/rb22_card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="⚡  PERFORMANCE MONITOR" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/ram" android:text="RAM     --" android:textColor="#FFFFFF"
            android:textSize="19sp" android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/temp" android:text="TEMP    --" android:textColor="#FFFFFF"
            android:textSize="19sp" android:layout_marginTop="9dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="FPS     --" android:textColor="#FFFFFF" android:textSize="19sp"
            android:layout_marginTop="9dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="PING    --" android:textColor="#FFFFFF" android:textSize="19sp"
            android:layout_marginTop="9dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:text="BOOST MODE" android:textColor="#A6B5E6" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <Button android:id="@+id/basic" android:text="BASIC" android:textAllCaps="false"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
        <Button android:id="@+id/advanced" android:text="ADVANCED" android:textAllCaps="false"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:layout_width="0dp" android:layout_height="52dp"/>
    </LinearLayout>
    <Button android:id="@+id/extreme" android:text="🔥  TURBO BOOST" android:textAllCaps="false"
        android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
    <Button android:id="@+id/overlay" android:text="F8 / EDGE PERFORMANCE OVERLAY" android:textAllCaps="false"
        android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="52dp"/>

    <TextView android:text="NETWORK OPTIMIZER" android:textColor="#A6B5E6" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="vertical" android:padding="18dp"
        android:layout_marginTop="10dp" android:background="@drawable/rb22_card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="DNS can improve name-resolution time, but it cannot guarantee lower in-game ping."
            android:textColor="#9AA8D8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/dns_auto" android:text="⚡ AUTO TEST — FIND FASTEST DNS"
            android:textAllCaps="false" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="52dp"/>
        <Button android:id="@+id/dns_cloudflare" android:text="1.1.1.1  •  Cloudflare"
            android:textAllCaps="false" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/dns_google" android:text="8.8.8.8  •  Google"
            android:textAllCaps="false" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/dns_quad9" android:text="9.9.9.9  •  Quad9"
            android:textAllCaps="false" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/dns_adguard" android:text="94.140.14.14  •  AdGuard"
            android:textAllCaps="false" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="48dp"/>
        <TextView android:id="@+id/dns_status" android:text="DNS: Not tested"
            android:textColor="#DCE5FF" android:textSize="13sp" android:layout_marginTop="10dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:text="SMART AI AUTOMATION" android:textColor="#A6B5E6" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="vertical" android:padding="18dp"
        android:layout_marginTop="10dp" android:background="@drawable/rb22_card"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="RB22 Smart Engine"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Automatically reacts to RAM pressure, temperature and network conditions."
            android:textColor="#9AA8D8" android:textSize="13sp" android:layout_marginTop="5dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/smart_auto" android:text="🤖 ENABLE SMART AUTOMATION"
            android:textAllCaps="false" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="52dp"/>
        <TextView android:text="• Auto RAM cleanup at 70%+&#10;• Thermal-aware boost adjustment&#10;• Game launch optimization&#10;• Network/DNS recommendation&#10;• Battery-aware mode"
            android:textColor="#DCE5FF" android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:text="QUICK TOOLS" android:textColor="#A6B5E6" android:textSize="13sp"
        android:textStyle="bold" android:layout_marginTop="28dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="🧹 Smart RAM Cleaner&#10;🎮 Game Profile Manager&#10;🌡️ Thermal Guard&#10;📶 Network Monitor&#10;🔋 Battery Saver while idle"
        android:textColor="#DCE5FF" android:textSize="15sp" android:lineSpacingExtra="6dp"
        android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>