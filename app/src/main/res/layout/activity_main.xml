<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/rb22_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/rb22_bg" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="18dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:src="@drawable/rb22_logo" android:contentDescription="RB22"
            android:layout_width="58dp" android:layout_height="58dp"/>
        <LinearLayout android:orientation="vertical" android:layout_marginStart="12dp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="RB22" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ULTIMATE  •  v3.6.0  •  MAX FPS" android:textColor="#B8FFE7" android:textSize="11sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:text="● LIVE" android:textColor="#B8FFE7" android:textSize="11sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="PERFORMANCE" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/ram" android:text="RAM  --" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/temp" android:text="TEMP  --" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:gravity="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="9dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/device_refresh" android:text="REFRESH" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="40dp"/>
        <TextView android:text="FPS  •  HUD" android:textColor="#C9D7FF" android:textSize="13sp"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:text="NET  •  READY" android:textColor="#B8FFE7" android:textSize="13sp"
                android:gravity="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="14dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="GAME BOOSTER" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/booster_status" android:text="○ BOOSTER OFF" android:textColor="#B8FFE7"
                android:textSize="10sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:text="Master control for RB22 automation and the gaming overlay"
            android:textColor="#A8B4C9" android:textSize="11sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="9dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/start_booster" android:text="▶ START BOOSTER" android:textAllCaps="false"
                android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"/>
            <Button android:id="@+id/stop_booster" android:text="■ TURN OFF" android:textAllCaps="false"
                android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>

    <Button android:id="@+id/extreme" android:text="⚡  MAX FPS" android:textAllCaps="false"
        android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="56dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/basic" android:text="BALANCED" android:textAllCaps="false"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
        <Button android:id="@+id/advanced" android:text="ADVANCED" android:textAllCaps="false"
            android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
    </LinearLayout>
    <TextView android:id="@+id/boost_status" android:text="READY  •  SELECT A MODE"
        android:textColor="#B8FFE7" android:textSize="11sp" android:textStyle="bold" android:gravity="center"
        android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/overlay" android:text="◉  START TRANSPARENT HUD" android:textAllCaps="false"
        android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="16dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="SMART ENGINE" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Adaptive • thermal guard • RAM monitor • game profiles"
            android:textColor="#C9D7FF" android:textSize="12sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/ultimate_status" android:text="ENGINE: STARTING…"
            android:textColor="#B8FFE7" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="9dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/smart_auto" android:text="ENABLE SMART AUTOMATION" android:textAllCaps="false"
            android:layout_marginTop="9dp" android:layout_width="match_parent" android:layout_height="48dp"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="12dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="NETWORK  •  GAMING PING" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/dns_auto" android:text="⚡ AUTO DNS" android:textAllCaps="false"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <Button android:id="@+id/gaming_ping" android:text="🎯 FIND LOWEST GAMING PING" android:textAllCaps="false"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="48dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/dns_cloudflare" android:text="1.1.1.1" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"/>
            <Button android:id="@+id/dns_google" android:text="8.8.8.8" android:textAllCaps="false" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"/>
            <Button android:id="@+id/dns_quad9" android:text="9.9.9.9" android:textAllCaps="false" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/dns_adguard" android:text="AdGuard" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"/>
            <Button android:id="@+id/dns_opendns" android:text="OpenDNS" android:textAllCaps="false" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"/>
        </LinearLayout>
        <TextView android:id="@+id/dns_status" android:text="DNS: NOT TESTED" android:textColor="#B8FFE7" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="12dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="GAME LIBRARY" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/game_library_status" android:text="No games saved"
            android:textColor="#C9D7FF" android:textSize="12sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/add_game" android:text="＋ ADD" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
            <Button android:id="@+id/game_library" android:text="OPEN" android:textAllCaps="false" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="12dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="DEVICE HEALTH" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Lightweight check — no background cleanup tricks or forced CPU changes." android:textColor="#A8B4C9" android:textSize="11sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Refresh RAM and temperature from the current device state." android:textColor="#B8FFE7" android:textSize="10sp" android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:orientation="vertical" android:padding="15dp" android:layout_marginTop="12dp"
        android:background="@drawable/rb22_card" android:tag="rb22_card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="📱 RB22 MOBILE" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Dedicated mobile gaming controls • Dark Moon Aurora • independent from PC"
            android:textColor="#C9D7FF" android:textSize="12sp" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="MAX FPS  •  LOW OVERHEAD  •  GAMING PING  •  DARK AURORA"
            android:textColor="#B8FFE7" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="8dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="9dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/mobile_game_mode" android:text="GAME MODE" android:textAllCaps="false"
                android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"/>
            <Button android:id="@+id/mobile_tools" android:text="EXTRA TOOLS" android:textAllCaps="false"
                android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"/>
        </LinearLayout>
        <Button android:id="@+id/mobile_charging" android:text="🔋 CHARGING MODE" android:textAllCaps="false"
            android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="46dp"/>
        <TextView android:text="Angel Snap stays PC-only"
            android:textColor="#7182A8" android:textSize="10sp" android:gravity="center"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:text="RB22  •  PERFORMANCE-FIRST  •  SAFE SYSTEM CONTROLS"
        android:textColor="#7182A8" android:textSize="9sp" android:gravity="center"
        android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>