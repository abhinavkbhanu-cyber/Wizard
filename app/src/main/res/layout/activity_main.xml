<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/rb22_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/rb22_bg" android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="18dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:src="@drawable/rb22_logo" android:contentDescription="RB22"
            android:layout_width="58dp" android:layout_height="58dp"/>
        <LinearLayout android:orientation="vertical" android:layout_marginStart="12dp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="RB22" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="ANDROID BETA • v1.0 • BOOST / NETWORK / PROTECT" android:textColor="#FFB8C0" android:textSize="10sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:text="● BETA" android:textColor="#FF6472" android:textSize="11sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
<!-- Remaining dashboard content retained from the existing Android layout. -->
</LinearLayout>
</ScrollView>
