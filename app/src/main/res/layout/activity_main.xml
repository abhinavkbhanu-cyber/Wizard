<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070912">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="RB22" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="🤖  AUTOPILOT" android:textColor="#79E8FF" android:textSize="20sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="● ACTIVE" android:textColor="#72F0A4" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_marginTop="20dp" android:background="#162033" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="PERFORMANCE" android:textColor="#AFC7FF" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/ram" android:text="RAM     --" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/temp" android:text="TEMP    --" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="FPS     --" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="PING    --" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:text="AI DECISION" android:textColor="#AFC7FF" android:textSize="13sp" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="⚡ Performance optimized&#10;🌡️ Thermal: Normal&#10;🧠 RAM: Monitored&#10;🌐 Network: Monitored" android:textColor="#FFFFFF" android:textSize="16sp" android:lineSpacingExtra="6dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="BOOST MODE" android:textColor="#AFC7FF" android:textSize="13sp" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<Button android:id="@+id/basic" android:text="BASIC" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/advanced" android:text="ADVANCED" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
<Button android:id="@+id/extreme" android:text="🔥 EXTREME FPS" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/overlay" android:text="ENABLE RIGHT-EDGE OVERLAY" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
